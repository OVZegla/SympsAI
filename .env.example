# =============================================================================
# Symp's AI — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. The three SECRET keys below must stay server-side
# only (spec §47) — anything prefixed with NEXT_PUBLIC_ is shipped to the
# browser, everything else is not.

# --- Supabase (public, safe for the browser) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET — server only) -----------------------------------------
# Bypasses Row Level Security. Only used by lib/supabase/admin.ts (and the
# reindex script) in trusted server contexts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Assistant IA (LOCAL par défaut — aucune clé requise) --------------------
# "ollama" = 100% local et gratuit (défaut). "anthropic" = Claude (payant, clé
# requise). Hybride possible : garde ollama partout et route uniquement le
# diagnostic vers Claude avec LLM_DIAGNOSIS_PROVIDER=anthropic.
LLM_PROVIDER=ollama
# LLM_DIAGNOSIS_PROVIDER=anthropic
OLLAMA_LLM_MODEL=qwen2.5
OLLAMA_LLM_FAST_MODEL=qwen2.5
OLLAMA_VISION_MODEL=llama3.2-vision
# LLM_TIMEOUT_MS=120000

# --- Anthropic (SECRET — server only; requis SEULEMENT si provider=anthropic) -
ANTHROPIC_API_KEY=
# Model ids are ALWAYS configurable, never hard-coded (spec §55, error #9).
CLAUDE_PRIMARY_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# --- Embeddings (LOCAL — no API key required) --------------------------------
# Embeddings run fully locally through Ollama. No external embedding key.
# Ollama is reached from the server only; the browser never calls it.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional tuning:
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_TIMEOUT_MS=30000

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_ENV=development

# --- Dropbox (SECRET — server only; facultatif) -------------------------------
# Liaison du compte Dropbox pour importer la documentation depuis le cloud.
# Ne rien remplir à la main : lance `npm run dropbox:link` qui écrit ces
# valeurs dans .env.local (jamais exposées au navigateur).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Dossier à fouiller, ex. /Symps/Documentations (vide = tout le Dropbox)
DROPBOX_FOLDER=

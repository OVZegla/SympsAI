# =============================================================================
# Symp's AI — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. The three SECRET keys below must stay server-side
# only (spec §47) — anything prefixed with NEXT_PUBLIC_ is shipped to the
# browser, everything else is not.

# --- Supabase (public, safe for the browser) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET — server only) -----------------------------------------
# Bypasses Row Level Security. Only used by lib/supabase/admin.ts in trusted
# server contexts (document ingestion, background jobs).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (SECRET — server only) ----------------------------------------
ANTHROPIC_API_KEY=
# Model ids are ALWAYS configurable, never hard-coded (spec §55, error #9).
CLAUDE_PRIMARY_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# --- Voyage embeddings (SECRET — server only) --------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=rerank-2.5-lite

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_ENV=development
